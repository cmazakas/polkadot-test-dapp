{
  "name": "brave-wallet-test-dapp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --outfile=dist/bundle.js --sourcemap",
    "watch": "esbuild src/main.js --bundle --outfile=dist/bundle.js --sourcemap --watch",
    "certs": "bash scripts/gen-certs.sh",
    "serve": "node server.js",
    "start": "npm run build && npm run serve"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@polkadot/extension-dapp": "^0.64.1",
    "@polkadot/types": "16.5.6",
    "@polkadot/util": "14.0.3"
  }
}
